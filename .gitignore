#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
pubspec_overrides.yaml

# Local build outputs and distributable binaries
/dist/
*.apk
*.aab
*.ipa

# Unreferenced local render; the canonical source lives in assets/brand/.
/macos/Runner/Assets.xcassets/AppIcon.appiconset/fknotes_icon.svg.png

# Local environment and secrets
.env
.env.*
!.env.example
**/key.properties
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*.mobileprovision

# Local note data and exported backups must never enter source control
fknotes.db
fknotes.db-*
notes-manifest.json
*.fknotes
*.fknotes.zip

# Android generated state
/android/.gradle/
/android/.kotlin/
/android/build/
/android/local.properties
/android/captures/

# Apple generated state
**/Pods/
**/.symlinks/
**/DerivedData/
**/xcuserdata/
*.xcuserstate

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
